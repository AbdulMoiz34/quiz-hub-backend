# Copy to .env; never commit actual secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
MONGODB_URI=mongodb+srv://DB_USERNAME:URL_ENCODED_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/quiz_hub?retryWrites=true&w=majority
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_32_PLUS_CHAR_SECRET
COOKIE_SAME_SITE=lax

# Used by npm run seed:admin only; remove after seeding if desired.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_ADMIN_PASSWORD
